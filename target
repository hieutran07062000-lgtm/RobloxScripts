-- GET PLAYERS WITHIN 350 STUDS
local function getTargets()
    local result = {}
    local character = player.Character
    local myRoot = character
        and character:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return result
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                local distance = (myRoot.Position - root.Position).Magnitude

                if distance <= MAX_DISTANCE then
                    table.insert(result, p)
                end
            end
        end
    end

    table.sort(result, function(a, b)
        return a.UserId < b.UserId
    end)

    return result
end

-- SELECT TARGET
local function chooseTarget()
    local targets = getTargets()

    if #targets == 0 then
        targetPlayer = nil
        title.Text = "TARGET PLAYER"
        status.Text = "No target within 350 studs"
        return false
    end

    local currentIndex = 0

    for i, p in ipairs(targets) do
        if p == targetPlayer then
            currentIndex = i
            break
        end
    end

    targetIndex = currentIndex % #targets + 1
    targetPlayer = targets[targetIndex]

    title.Text = "TARGET: " .. targetPlayer.Name
    status.Text = "Range: 350 studs"
    return true
end

local function stopFollowing()
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
end

-- TOGGLE TARGET MODE
local function setEnabled(state)
    enabled = state
    stopFollowing()

    if not enabled then
        targetPlayer = nil
        title.Text = "TARGET PLAYER"
        status.Text = "Status: OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(65, 70, 90)
        return
    end

    toggle.BackgroundColor3 = Color3.fromRGB(40, 155, 95)

    if not chooseTarget() then
        status.Text = "No target within 350 studs"
        return
    end

    followConnection = RunService.Heartbeat:Connect(function()
        if not enabled then return end

        local character = player.Character
        local myRoot = character
            and character:FindFirstChild("HumanoidRootPart")

        local targetCharacter = targetPlayer and targetPlayer.Character
        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = targetCharacter
            and targetCharacter:FindFirstChildOfClass("Humanoid")

        if not myRoot or not targetRoot
            or not targetHumanoid or targetHumanoid.Health <= 0 then
            chooseTarget()
            return
        end

        local distance = (myRoot.Position - targetRoot.Position).Magnitude

        -- Stop targeting players outside the range
        if distance > MAX_DISTANCE then
            if not chooseTarget() then
                targetPlayer = nil
                status.Text = "No target within 350 studs"
            end
            return
        end

        -- Keep the character very close to the target.
        -- This client-side movement is intended for Studio testing.
        local offset = targetRoot.CFrame.RightVector * TARGET_DISTANCE
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        myRoot.CFrame = CFrame.lookAt(
            targetRoot.Position + offset,
            targetRoot.Position
        )
    end)
end

local function nextTarget()
    if not enabled then return end
    chooseTarget()
end

toggle.MouseButton1Click:Connect(function()
    setEnabled(not enabled)
end)

nextButton.MouseButton1Click:Connect(nextTarget)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.G then
        setEnabled(not enabled)
    elseif input.KeyCode == Enum.KeyCode.E then
        nextTarget()
    end
end)

player.CharacterAdded:Connect(function()
    if enabled then
        task.wait(1)
        if enabled then
            setEnabled(true)
        end
    end
end)
